      ]
    },
    {
      "id": "PastoriaCityEastHouse_Text_GuruNeedFourBadges",
      "en_US": [
        "Hmm... you lack experience.\n",
        "Come back when you have 4 Badges.\r"
      ]
    },
    {
      "id": "PastoriaCityEastHouse_Text_GuruOnlyOneAbility",
